DATABASE_URL=            # connection string de Neon
BLOB_READ_WRITE_TOKEN=   # token de Vercel Blob
ANTHROPIC_API_KEY=       # API key de Claude
AUTH_SECRET=             # secreto largo y aleatorio para firmar sesiones y códigos
ALLOWED_EMAILS=          # emails que pueden entrar, separados por comas
RESEND_API_KEY=          # API key de Resend, para enviar el código por email
EMAIL_FROM=              # opcional; por defecto Woodbase <onboarding@resend.dev>
